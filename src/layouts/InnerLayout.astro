---
/**
 * Shared layout for SEO inner pages.
 * All contact, shipping and stat data comes from src/data/site.json.
 * Individual pages only need to provide page-specific content.
 */
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

export interface Props {
  title: string;
  description: string;
  breadcrumb: string;
  h1: string;
  subtitle: string;
  whatsappMsg?: string;  // optional — defaults to site.contact.whatsapp_default_msg
}

const { title, description, breadcrumb, h1, subtitle, whatsappMsg } = Astro.props;
const msg = whatsappMsg ?? site.contact.whatsapp_default_msg;
const waLink = `https://wa.me/${site.contact.whatsapp_raw}?text=${encodeURIComponent(msg)}`;

// Expose site data to slot content via Astro.locals isn't possible in Astro,
// so we pass shipping + contact as named exports that pages can also import directly.
export { site };
---

<Layout title={title} description={description}>
  <Header />
  <main id="main-content">

    <!-- Hero -->
    <section class="inner-hero">
      <div class="inner-hero-bg" aria-hidden="true"></div>
      <div class="container inner-hero-content">
        <nav class="breadcrumb" aria-label="Ruta de navegación">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{breadcrumb}</span>
        </nav>
        <span class="section-label">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
          KaraFun Chile
        </span>
        <h1 class="inner-title">{h1}</h1>
        <p class="inner-subtitle">{subtitle}</p>
        <div class="inner-actions">
          <a href="/#precios" class="btn-primary-inner">
            Ver paquetes y precios
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-secondary-inner">
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Dynamic content slot -->
    <slot />

    <!-- Final CTA -->
    <section class="inner-cta-section">
      <div class="container">
        <h2 class="inner-cta-title">¿Listo para dar el siguiente paso?</h2>
        <p class="inner-cta-desc">Asesoría personalizada sin costo. Escríbenos y te ayudamos a elegir el paquete ideal.</p>
        <div class="inner-actions">
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-primary-inner">
            Consultar por WhatsApp
          </a>
          <a href="/#precios" class="btn-outline-inner">Ver todos los paquetes</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style is:global>
  /* ─── Inner Hero ─────────────────────────────────── */
  .inner-hero {
    position: relative;
    padding: 140px 0 80px;
    background: linear-gradient(145deg, var(--deep) 0%, #1a0840 50%, var(--deep) 100%);
    overflow: hidden;
  }
  .inner-hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(115,20,189,0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(115,20,189,0.07) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black, transparent);
    pointer-events: none;
  }
  .inner-hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
  }
  .breadcrumb a { color: var(--text-muted); transition: color 0.2s; }
  .breadcrumb a:hover { color: var(--white); }
  .breadcrumb span[aria-current] { color: var(--accent); }

  .inner-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--white);
  }
  .inner-subtitle {
    font-size: 17px;
    line-height: 1.75;
    color: rgba(237,232,255,0.65);
    max-width: 640px;
  }
  .inner-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding-top: 8px;
  }
  .btn-primary-inner {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
    background: linear-gradient(135deg, var(--purple), var(--pink));
    padding: 13px 26px;
    border-radius: 100px;
    transition: transform 0.25s var(--ease-spring), box-shadow 0.3s;
    box-shadow: 0 4px 20px rgba(115,20,189,0.4);
    white-space: nowrap;
  }
  .btn-primary-inner:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(115,20,189,0.55); }
  .btn-primary-inner svg { transition: transform 0.2s; }
  .btn-primary-inner:hover svg { transform: translateX(3px); }

  .btn-secondary-inner {
    font-size: 15px;
    font-weight: 600;
    color: rgba(237,232,255,0.75);
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.15);
    padding: 12px 24px;
    border-radius: 100px;
    transition: background 0.2s, color 0.2s;
    white-space: nowrap;
  }
  .btn-secondary-inner:hover { background: rgba(255,255,255,0.1); color: var(--white); }

  .btn-outline-inner {
    font-size: 15px;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.3);
    padding: 13px 26px;
    border-radius: 100px;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }
  .btn-outline-inner:hover { background: rgba(255,255,255,0.18); color: var(--white); border-color: rgba(255,255,255,0.5); }

  /* ─── Inner Sections ─────────────────────────────── */
  .inner-section { padding: 80px 0; }
  .inner-section--light { background: var(--light); }
  .inner-section--dark  { background: var(--dark); }

  .inner-section-title {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 16px;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .inner-section-title--light { color: var(--white); }
  .inner-section-desc {
    font-size: 16px;
    line-height: 1.8;
    color: #6B5A8A;
    max-width: 680px;
    margin-bottom: 40px;
  }
  .inner-section-desc--light { color: rgba(237,232,255,0.6); }

  /* Benefits */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 15px;
    color: var(--text-dark);
    line-height: 1.6;
    padding: 16px 20px;
    background: var(--white);
    border: 1px solid rgba(115,20,189,0.1);
    border-radius: var(--radius-md);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .benefit-item:hover { border-color: rgba(115,20,189,0.25); box-shadow: 0 4px 16px rgba(115,20,189,0.08); }
  .benefit-check {
    width: 22px; height: 22px;
    background: linear-gradient(135deg, var(--purple), var(--pink));
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    color: white;
    margin-top: 1px;
  }

  /* Feature list dark */
  .feature-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 40px;
  }
  .feature-list-item {
    font-size: 15px;
    color: rgba(237,232,255,0.7);
    line-height: 1.6;
    padding: 14px 20px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .feature-list-item strong { color: var(--white); }

  /* CTA box */
  .inner-cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 24px 28px;
    flex-wrap: wrap;
  }
  .inner-cta-label {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .inner-cta-plan {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--white);
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 40px;
  }
  .faq-item {
    background: var(--white);
    border: 1px solid rgba(115,20,189,0.1);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.2s;
  }
  .faq-item[open] { border-color: rgba(115,20,189,0.3); }
  .faq-q {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--text-dark);
    padding: 18px 20px;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    user-select: none;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after {
    content: '+';
    font-size: 20px;
    font-weight: 300;
    color: var(--purple);
    flex-shrink: 0;
    transition: transform 0.25s var(--ease-out);
  }
  .faq-item[open] .faq-q::after { transform: rotate(45deg); }
  .faq-a {
    font-size: 15px;
    color: #6B5A8A;
    line-height: 1.7;
    padding: 0 20px 20px;
    margin: 0;
  }

  /* Final CTA */
  .inner-cta-section {
    background: linear-gradient(135deg, var(--purple) 0%, var(--pink) 100%);
    padding: 80px 0;
    text-align: center;
  }
  .inner-cta-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 800;
    color: var(--white);
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }
  .inner-cta-desc {
    font-size: 17px;
    color: rgba(255,255,255,0.8);
    margin-bottom: 36px;
  }
  .inner-cta-section .inner-actions { justify-content: center; }
  .inner-cta-section .btn-primary-inner {
    background: var(--white);
    color: var(--purple);
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
  }
  .inner-cta-section .btn-primary-inner:hover { box-shadow: 0 8px 32px rgba(0,0,0,0.3); }

  /* Responsive */
  @media (max-width: 768px) {
    .benefits-grid, .feature-list { grid-template-columns: 1fr; }
    .inner-cta-box { flex-direction: column; align-items: flex-start; }
    .inner-hero { padding: 120px 0 60px; }
  }
  @media (max-width: 480px) {
    .inner-actions { flex-direction: column; width: 100%; }
    .btn-primary-inner,
    .btn-secondary-inner,
    .btn-outline-inner { width: 100%; justify-content: center; }
  }
</style>
