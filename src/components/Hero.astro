---
import site from '../data/site.json';
---

<section id="inicio" class="hero">

  <!-- Particle Canvas (pure CSS) -->
  <div class="hero-particles" aria-hidden="true">
    {Array.from({ length: 24 }).map((_, i) => (
      <span class={`particle particle--${(i % 4) + 1}`} style={`
        left: ${(i * 4.2 + 2) % 100}%;
        animation-delay: ${(i * 0.37).toFixed(2)}s;
        animation-duration: ${(10 + (i % 7) * 1.3).toFixed(1)}s;
        width: ${2 + (i % 4)}px;
        height: ${2 + (i % 4)}px;
        opacity: ${(0.15 + (i % 5) * 0.08).toFixed(2)};
      `} />
    ))}
  </div>

  <!-- Gradient orbs -->
  <div class="hero-orb hero-orb--1" aria-hidden="true"></div>
  <div class="hero-orb hero-orb--2" aria-hidden="true"></div>

  <div class="hero-inner container">

    <!-- Left: Content -->
    <div class="hero-content">

      <div class="hero-badge reveal">
        <span class="badge-dot"></span>
        Distribuidor Oficial KaraFun · Chile
      </div>

      <h1 class="hero-title reveal">
        El karaoke profesional<br />
        <span class="hero-title--gradient">que Chile merece</span>
      </h1>

      <p class="hero-description reveal">
        Más de {site.stats.years} años llevando la experiencia KaraFun a pubs, restaurantes, bares,
        DJs y empresas de eventos en todo Chile. Proveedor certificado, soporte local,
        entrega en 24 horas.
      </p>

      <div class="hero-actions reveal">
        <a href="#precios" class="btn-primary">
          Ver paquetes
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href={`https://wa.me/${site.contact.whatsapp_raw}?text=${encodeURIComponent(site.contact.whatsapp_default_msg)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Consultar por WhatsApp
        </a>
      </div>

      <!-- Stats -->
      <div class="hero-stats reveal">
        <div class="stat">
          <span class="stat-number" data-target="12300">0</span>
          <span class="stat-suffix">+</span>
          <span class="stat-label">Clientes activos</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat">
          <span class="stat-number" data-target="118500">0</span>
          <span class="stat-suffix">+</span>
          <span class="stat-label">Videos musicales</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat">
          <span class="stat-number" data-target="183000">0</span>
          <span class="stat-suffix">+</span>
          <span class="stat-label">Temas Mp3</span>
        </div>
      </div>
    </div>

    <!-- Right: Hero image -->
    <div class="hero-image-wrap reveal">
      <div class="hero-image-glow" aria-hidden="true"></div>
      <img
        src="/images/header-bg.png"
        alt="Sistema KaraFun en acción"
        class="hero-image"
        width="640"
        height="480"
        loading="eager"
      />
    </div>
  </div>

  <!-- Bottom fade -->
  <div class="hero-fade" aria-hidden="true"></div>
</section>

<script>
  // ─── Scroll reveal ──────────────────────────────────
  const revealEls = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry, idx) => {
        if (entry.isIntersecting) {
          // Stagger delay for hero elements
          const delay = entry.target.closest('.hero-content, .hero-image-wrap')
            ? 0
            : idx * 80;
          setTimeout(() => entry.target.classList.add('is-visible'), delay);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );
  revealEls.forEach(el => observer.observe(el));

  // ─── Stats counter ─────────────────────────────────
  const formatNumber = (n: number) =>
    n >= 1000 ? n.toLocaleString('es-CL') : String(n);

  const animateCounter = (el: HTMLElement) => {
    const target = parseInt(el.dataset.target || '0', 10);
    const duration = 1800;
    const start = performance.now();

    const step = (now: number) => {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      // Ease out expo
      const eased = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
      el.textContent = formatNumber(Math.round(eased * target));
      if (progress < 1) requestAnimationFrame(step);
    };

    requestAnimationFrame(step);
  };

  const statsObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCounter(entry.target as HTMLElement);
          statsObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.5 }
  );

  document.querySelectorAll('.stat-number').forEach(el => statsObserver.observe(el));

  // Hero elements stagger on load
  const heroReveal = document.querySelectorAll('.hero .reveal');
  heroReveal.forEach((el, i) => {
    setTimeout(() => el.classList.add('is-visible'), 200 + i * 120);
  });
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    background: linear-gradient(
      145deg,
      #07011A 0%,
      #120833 40%,
      #1f0542 70%,
      #07011A 100%
    );
    overflow: hidden;
    padding-top: 72px; /* header height */
  }

  /* ─── Particles ─────────────────────────────────── */
  .hero-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .particle {
    position: absolute;
    bottom: -10px;
    border-radius: 50%;
    animation: float-up linear infinite;
  }

  .particle--1 { background: var(--accent); }
  .particle--2 { background: var(--purple-mid); }
  .particle--3 { background: var(--pink); }
  .particle--4 { background: rgba(255, 255, 255, 0.6); }

  @keyframes float-up {
    0%   { transform: translateY(0) scale(1); opacity: 0; }
    5%   { opacity: 1; }
    90%  { opacity: 0.4; }
    100% { transform: translateY(-110vh) scale(0.4); opacity: 0; }
  }

  /* ─── Orbs ──────────────────────────────────────── */
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }
  .hero-orb--1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(115, 20, 189, 0.35) 0%, transparent 70%);
    top: -100px;
    right: -100px;
  }
  .hero-orb--2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(213, 22, 122, 0.25) 0%, transparent 70%);
    bottom: -50px;
    left: 10%;
  }

  /* ─── Layout ─────────────────────────────────────── */
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 60px;
    padding-top: 40px;
    padding-bottom: 80px;
  }

  /* ─── Content ────────────────────────────────────── */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(196, 113, 237, 0.1);
    border: 1px solid rgba(196, 113, 237, 0.3);
    padding: 7px 16px;
    border-radius: 100px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%       { transform: scale(1.5); opacity: 0.6; }
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 68px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--white);
  }

  .hero-title--gradient {
    background: linear-gradient(135deg, var(--purple-light) 0%, var(--pink-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    font-size: 17px;
    line-height: 1.75;
    color: rgba(237, 232, 255, 0.65);
    max-width: 460px;
  }

  /* ─── Buttons ────────────────────────────────────── */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
    background: linear-gradient(135deg, var(--purple) 0%, var(--pink) 100%);
    padding: 14px 28px;
    border-radius: 100px;
    transition: transform 0.25s var(--ease-spring), box-shadow 0.3s ease;
    box-shadow: 0 4px 24px rgba(115, 20, 189, 0.4);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(115, 20, 189, 0.6);
  }
  .btn-primary svg {
    transition: transform 0.2s;
  }
  .btn-primary:hover svg {
    transform: translateX(3px);
  }

  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--white);
    background: rgba(37, 211, 102, 0.12);
    border: 1px solid rgba(37, 211, 102, 0.35);
    padding: 13px 24px;
    border-radius: 100px;
    transition: background 0.25s, border-color 0.25s, transform 0.25s var(--ease-spring);
  }
  .btn-whatsapp:hover {
    background: rgba(37, 211, 102, 0.22);
    border-color: rgba(37, 211, 102, 0.6);
    transform: translateY(-2px);
  }

  /* ─── Stats ──────────────────────────────────────── */
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-top: 8px;
  }

  .stat {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 800;
    color: var(--white);
    line-height: 1;
  }

  .stat-suffix {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }

  .stat-label {
    width: 100%;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .stat-divider {
    width: 1px;
    height: 36px;
    background: var(--border);
    flex-shrink: 0;
  }

  /* ─── Image ──────────────────────────────────────── */
  .hero-image-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image-glow {
    position: absolute;
    inset: 10%;
    background: radial-gradient(circle, rgba(115, 20, 189, 0.4), transparent 70%);
    filter: blur(40px);
    border-radius: 50%;
    animation: glow-pulse 4s ease-in-out infinite;
  }

  @keyframes glow-pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50%       { opacity: 1;   transform: scale(1.08); }
  }

  .hero-image {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 580px;
    border-radius: var(--radius-xl);
    animation: float-image 6s ease-in-out infinite;
    filter: drop-shadow(0 20px 60px rgba(115, 20, 189, 0.4));
  }

  @keyframes float-image {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-12px); }
  }

  /* ─── Bottom fade ────────────────────────────────── */
  .hero-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background: linear-gradient(to bottom, transparent, var(--light));
    pointer-events: none;
  }

  /* ─── Responsive ─────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
      padding-bottom: 60px;
    }
    .hero-content {
      align-items: center;
      order: 1;
    }
    .hero-image-wrap {
      order: 0;
      max-width: 480px;
      margin: 0 auto;
    }
    .hero-description {
      text-align: center;
    }
    .hero-stats {
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
    }
    .stat-divider {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .hero {
      min-height: auto;
      padding-bottom: 0;
    }
    .hero-title {
      font-size: clamp(32px, 8vw, 48px);
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-primary,
    .btn-whatsapp {
      width: 100%;
      justify-content: center;
    }
    .hero-stats {
      gap: 16px;
    }
  }
</style>
