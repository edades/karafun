---
---

<section id="nosotros" class="about">

  <!-- Background texture lines -->
  <div class="about-bg" aria-hidden="true"></div>

  <div class="about-inner container">

    <!-- Image side -->
    <div class="about-media reveal">
      <div class="about-frame">
        <img
          src="/images/section4.jpg"
          alt="Karafun Chile — Equipo en acción"
          width="540"
          height="480"
          loading="lazy"
          class="about-img"
        />
        <div class="about-frame-glow" aria-hidden="true"></div>
      </div>
      <!-- Floating badge -->
      <div class="about-badge">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <div>
          <span class="badge-main">Distribuidor Oficial</span>
          <span class="badge-sub">Certificado por KaraFun</span>
        </div>
      </div>
    </div>

    <!-- Content side -->
    <div class="about-content">

      <span class="section-label reveal">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        KaraFun en Chile
      </span>

      <h2 class="section-title about-title reveal">
        Los únicos autorizados<br />
        <span class="about-title--accent">en Chile</span>
      </h2>

      <p class="about-desc reveal">
        Nacimos de la necesidad de contar con un sistema profesional de karaoke en Chile,
        con sonido real y control de tonalidad en tiempo real. Este sistema lo traemos
        directamente desde España, del fabricante, siendo los únicos autorizados para
        vender y asesorar en negocios y eventos en el país.
      </p>

      <p class="about-desc reveal">
        KaraFun es el karaoke más exitoso en América Latina y Norteamérica.
        Con más de una década de operación, hemos atendido pubs, restaurantes, bares,
        DJs y empresas de eventos en todo Chile.
      </p>

      <!-- Downloads -->
      <div class="about-downloads reveal">
        <span class="downloads-label">Descarga el listado completo de temas</span>
        <div class="downloads-btns">
          <a href="/docs/listado.xls" download class="dl-btn dl-btn--excel">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Descargar Excel
            <span class="dl-format">XLSX</span>
          </a>
          <a href="/docs/listado.pdf" download class="dl-btn dl-btn--pdf">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Descargar PDF
            <span class="dl-format">PDF</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .about {
    background: var(--dark);
    padding: 100px 0;
    position: relative;
    overflow: hidden;
  }

  /* Decorative grid lines */
  .about-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(115, 20, 189, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(115, 20, 189, 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black, transparent);
  }

  .about-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 80px;
  }

  /* ─── Media ──────────────────────────────────────── */
  .about-media {
    position: relative;
  }

  .about-frame {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .about-img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: var(--radius-xl);
    display: block;
    filter: brightness(0.9) saturate(1.1);
    transition: transform 0.6s var(--ease-out);
  }

  .about-frame:hover .about-img {
    transform: scale(1.03);
  }

  .about-frame-glow {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-xl);
    box-shadow: inset 0 0 0 1px rgba(196, 113, 237, 0.25);
    pointer-events: none;
  }

  /* Floating badge */
  .about-badge {
    position: absolute;
    bottom: -20px;
    right: -20px;
    background: rgba(23, 9, 64, 0.9);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: var(--shadow-purple);
    color: var(--accent);
  }

  .about-badge svg {
    flex-shrink: 0;
    color: var(--accent);
  }

  .badge-main {
    display: block;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    color: var(--white);
    line-height: 1.2;
  }

  .badge-sub {
    display: block;
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    margin-top: 2px;
  }

  /* ─── Content ────────────────────────────────────── */
  .about-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .about-title {
    color: var(--white);
    line-height: 1.15;
  }

  .about-title--accent {
    background: linear-gradient(135deg, var(--purple-light), var(--pink-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .about-desc {
    font-size: 16px;
    line-height: 1.8;
    color: rgba(237, 232, 255, 0.65);
  }

  /* ─── Downloads ──────────────────────────────────── */
  .about-downloads {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    margin-top: 8px;
  }

  .downloads-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  .downloads-btns {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .dl-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    padding: 11px 20px;
    border-radius: var(--radius-sm);
    transition: transform 0.25s var(--ease-spring), box-shadow 0.25s, background 0.25s;
    position: relative;
    overflow: hidden;
  }

  .dl-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s;
    background: rgba(255, 255, 255, 0.06);
  }
  .dl-btn:hover::before { opacity: 1; }
  .dl-btn:hover {
    transform: translateY(-2px);
  }

  .dl-btn--excel {
    color: var(--white);
    background: rgba(34, 150, 85, 0.2);
    border: 1px solid rgba(34, 150, 85, 0.4);
  }
  .dl-btn--excel:hover {
    box-shadow: 0 6px 20px rgba(34, 150, 85, 0.25);
  }

  .dl-btn--pdf {
    color: var(--white);
    background: rgba(213, 22, 122, 0.15);
    border: 1px solid rgba(213, 22, 122, 0.35);
  }
  .dl-btn--pdf:hover {
    box-shadow: 0 6px 20px rgba(213, 22, 122, 0.25);
  }

  .dl-format {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.12);
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* ─── Responsive ─────────────────────────────────── */
  @media (max-width: 1024px) {
    .about-inner {
      grid-template-columns: 1fr;
      gap: 60px;
    }
    .about-badge {
      bottom: 16px;
      right: 16px;
    }
    .about-img {
      height: 360px;
    }
  }

  @media (max-width: 640px) {
    .about {
      padding: 80px 0;
    }
    .about-badge {
      position: static;
      margin-top: 16px;
    }
    .downloads-btns {
      flex-direction: column;
    }
    .dl-btn {
      justify-content: center;
    }
  }
</style>
