---
const currentYear = new Date().getFullYear();
import site from '../data/site.json';
---

<footer class="footer">
  <div class="footer-inner container">

    <div class="footer-top">

      <!-- Brand -->
      <div class="footer-brand">
        <a href="#inicio" aria-label="KaraFun Chile — Inicio">
          <img src="/images/logo.png" alt="KaraFun Chile" width="120" height="40" loading="lazy" />
        </a>
        <p class="footer-tagline">
          Distribuidor oficial KaraFun en Chile.<br />
          El sistema de karaoke profesional más completo del mercado.
        </p>
        <!-- Social/contact -->
        <div class="footer-socials">
          <a
            href={`https://wa.me/${site.contact.whatsapp_raw}`}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social"
            aria-label="WhatsApp KaraFun Chile"
            style="display:grid;place-items:center;width:38px;height:38px;"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              style="display:block;width:18px;height:18px;flex-shrink:0;"
            >
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
          <a
            href={`mailto:${site.contact.email}`}
            class="footer-social"
            aria-label="Email KaraFun Chile"
            style="display:grid;place-items:center;width:38px;height:38px;"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              style="display:block;width:18px;height:18px;flex-shrink:0;"
            >
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Nav links -->
      <nav class="footer-nav" aria-label="Navegación del pie de página">
        <h4 class="footer-nav-title">Navegación</h4>
        <ul>
          <li><a href="/#inicio" class="footer-link">Inicio</a></li>
          <li><a href="/#caracteristicas" class="footer-link">Características</a></li>
          <li><a href="/#precios" class="footer-link">Paquetes</a></li>
          <li><a href="/#tutoriales" class="footer-link">Tutoriales</a></li>
          <li><a href="/#contacto" class="footer-link">Contacto</a></li>
        </ul>
      </nav>

      <!-- Para tu negocio -->
      <nav class="footer-business" aria-label="Para tu negocio">
        <h4 class="footer-nav-title">Por negocio</h4>
        <ul>
          <li><a href="/karaoke-para-pub/" class="footer-link">Karaoke para pub</a></li>
          <li><a href="/karaoke-para-restaurante/" class="footer-link">Karaoke para restaurante</a></li>
          <li><a href="/karaoke-para-dj/" class="footer-link">Karaoke para DJ</a></li>
          <li><a href="/karaoke-para-eventos/" class="footer-link">Karaoke para eventos</a></li>
          <li><a href="/sistema-karaoke-profesional/" class="footer-link">Sistema profesional</a></li>
        </ul>
      </nav>

      <!-- Por ciudad -->
      <nav class="footer-cities" aria-label="Por ciudad">
        <h4 class="footer-nav-title">Por ciudad</h4>
        <ul>
          <li><a href="/karaoke-santiago/" class="footer-link">Santiago</a></li>
          <li><a href="/karaoke-valparaiso/" class="footer-link">Valparaíso / Viña</a></li>
          <li><a href="/karaoke-concepcion/" class="footer-link">Concepción</a></li>
        </ul>
      </nav>

      <!-- Downloads -->
      <div class="footer-downloads">
        <h4 class="footer-nav-title">Catálogos</h4>
        <ul>
          <li>
            <a href="/docs/listado.xls" download class="footer-link footer-link--dl">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Listado de temas XLSX
            </a>
          </li>
          <li>
            <a href="/docs/listado.pdf" download class="footer-link footer-link--dl">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Listado de temas PDF
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact info -->
      <div class="footer-contact">
        <h4 class="footer-nav-title">Contacto</h4>
        <ul class="footer-contact-list">
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.57 3.43 2 2 0 0 1 3.55 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9a16 16 0 0 0 6.29 6.29l1.06-1.06a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <a href={`tel:${site.contact.whatsapp_raw}`} class="footer-contact-link">{site.contact.phone_display}</a>
          </li>
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
            </svg>
            <a href={`mailto:${site.contact.email}`} class="footer-contact-link">{site.contact.email}</a>
          </li>
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Santiago, Chile</span>
          </li>
        </ul>
      </div>

    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {currentYear} KaraFun Chile — Todos los derechos reservados.
        Distribuidor oficial KaraFun para Chile.
      </p>
      <div class="footer-cert">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        Distribuidor certificado · Chile
      </div>
    </div>

  </div>
</footer>

<!-- Floating WhatsApp button -->
<a
  href={`https://wa.me/${site.contact.whatsapp_raw}?text=${encodeURIComponent(site.contact.whatsapp_default_msg)}`}
  target="_blank"
  rel="noopener noreferrer"
  class="wa-float"
  id="wa-float-btn"
  aria-label="Contactar por WhatsApp"
>
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
  <span class="wa-float-label">¿Preguntas?</span>
</a>

<style>
  .footer {
    background: var(--deep);
    border-top: 1px solid var(--border);
    padding: 72px 0 0;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ─── Top ────────────────────────────────────────── */
  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr 1.3fr;
    gap: 32px;
    padding-bottom: 56px;
  }

  /* Brand */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-brand a {
    display: inline-block;
    transition: opacity 0.2s;
  }
  .footer-brand a:hover { opacity: 0.8; }

  .footer-tagline {
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 280px;
  }

  .footer-socials {
    display: flex;
    gap: 10px;
  }

  .footer-social {
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
    flex-shrink: 0;
    line-height: 1;
  }
  .footer-social svg {
    display: block;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }
  .footer-social:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--border-strong);
    color: var(--white);
    transform: translateY(-2px);
  }

  /* Nav */
  .footer-nav-title {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(237, 232, 255, 0.4);
    margin-bottom: 20px;
  }

  .footer-nav ul,
  .footer-downloads ul,
  .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-link {
    font-size: 14px;
    color: var(--text-muted);
    transition: color 0.2s;
  }
  .footer-link:hover {
    color: var(--white);
  }

  .footer-link--dl {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .footer-link--dl svg {
    flex-shrink: 0;
  }

  /* Contact */
  .footer-contact-list {
    gap: 12px;
  }
  .footer-contact-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-muted);
  }
  .footer-contact-list svg {
    flex-shrink: 0;
    color: var(--accent);
  }
  .footer-contact-link {
    color: var(--text-muted);
    transition: color 0.2s;
  }
  .footer-contact-link:hover {
    color: var(--white);
  }

  /* ─── Bottom ─────────────────────────────────────── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: 13px;
    color: rgba(237, 232, 255, 0.3);
  }

  .footer-cert {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 500;
    color: var(--accent);
    background: rgba(196, 113, 237, 0.08);
    border: 1px solid rgba(196, 113, 237, 0.2);
    padding: 5px 12px;
    border-radius: 100px;
  }

  /* ─── WhatsApp Float ───────────────────────────────── */
  .wa-float {
    position: fixed;
    right: 24px;
    bottom: 28px;
    z-index: 99;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    background: #25D366;
    color: white;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    box-shadow: 0 4px 24px rgba(37, 211, 102, 0.45);
    font-size: 14px;
    font-weight: 600;
    font-family: var(--font-body);
    transition:
      width 0.35s var(--ease-out),
      border-radius 0.35s var(--ease-out),
      gap 0.35s var(--ease-out),
      box-shadow 0.3s,
      transform 0.3s var(--ease-spring);
    overflow: hidden;
    white-space: nowrap;
    padding: 0;
  }

  .wa-float svg {
    display: block;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
  }

  .wa-float-label {
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-width 0.35s var(--ease-out),
      opacity 0.25s 0.05s,
      margin-left 0.35s var(--ease-out);
    margin-left: 0;
    pointer-events: none;
  }

  .wa-float:hover {
    width: 176px;
    border-radius: 29px;
    gap: 0;
    padding: 0 20px 0 16px;
    transform: translateY(-3px);
    box-shadow: 0 8px 32px rgba(37, 211, 102, 0.6);
  }

  .wa-float:hover .wa-float-label {
    max-width: 110px;
    opacity: 1;
    margin-left: 10px;
  }

  /* ─── Responsive ─────────────────────────────────── */
  @media (max-width: 1300px) {
    .footer-top {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 28px;
    }
    .footer-brand {
      grid-column: span 4;
    }
  }

  @media (max-width: 960px) {
    .footer-top {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 28px;
    }
    .footer-brand {
      grid-column: span 3;
    }
  }

  @media (max-width: 720px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    .footer-brand {
      grid-column: span 2;
    }
  }

  @media (max-width: 480px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .footer-brand {
      grid-column: span 1;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
