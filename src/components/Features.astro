---
import site from '../data/site.json';
---

<section id="caracteristicas" class="features">
  <div class="container">

    <div class="features-header">
      <span class="section-label">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Por qué KaraFun
      </span>
      <h2 class="section-title section-title--dark features-title">
        Todo lo que necesitas<br />en un solo sistema
      </h2>
      <p class="section-subtitle section-subtitle--dark">
        Un sistema de karaoke profesional diseñado para entornos de alta exigencia.
        Sin YouTube, sin anuncios, sin interrupciones.
      </p>
    </div>

    <div class="features-grid">

      <article class="feature-card reveal">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
          </svg>
        </div>
        <div class="feature-body">
          <h3 class="feature-title">Contenido de calidad</h3>
          <p class="feature-desc">
            Más de {site.stats.videos} videos musicales limpios, producidos en estudio.
            <strong>Sin publicidad, sin fuentes de YouTube</strong>, con audio de alta fidelidad.
          </p>
        </div>
      </article>

      <article class="feature-card reveal">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
          </svg>
        </div>
        <div class="feature-body">
          <h3 class="feature-title">Todos los géneros</h3>
          <p class="feature-desc">
            Organizados por estilo, ritmo y décadas. Salsa, románticas, rock, cumbia,
            reggaeton, cueca, bachata, electrónica y mucho más.
          </p>
        </div>
      </article>

      <article class="feature-card reveal">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
          </svg>
        </div>
        <div class="feature-body">
          <h3 class="feature-title">Actualización continua</h3>
          <p class="feature-desc">
            Los temas se actualizan <strong>cada dos meses</strong> con lanzamientos
            nuevos. Siempre al día con los éxitos latinoamericanos y mundiales.
          </p>
        </div>
      </article>

      <article class="feature-card reveal">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
        </div>
        <div class="feature-body">
          <h3 class="feature-title">Compatible con todo</h3>
          <p class="feature-desc">
            Funciona en TV, PC, celular, tablet, automóvil y sistemas DJ.
            Salida directa por USB o software de mezcla profesional.
          </p>
        </div>
      </article>

      <article class="feature-card reveal">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>
          </svg>
        </div>
        <div class="feature-body">
          <h3 class="feature-title">Listo para usar</h3>
          <p class="feature-desc">
            Entrega en disco duro externo configurado y listo.
            Sin instalaciones complejas, sin suscripciones, sin depender de internet.
          </p>
        </div>
      </article>

      <article class="feature-card reveal">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div class="feature-body">
          <h3 class="feature-title">Soporte en Chile</h3>
          <p class="feature-desc">
            Asesoría directa en español, soporte post-venta y actualizaciones.
            El respaldo de más de <strong>12.300 clientes</strong> en todo el país.
          </p>
        </div>
      </article>

    </div>

    <!-- Extra info strip -->
    <div class="features-strip reveal">
      <div class="strip-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
        </svg>
        <span>Más de <strong>500 GB</strong> de música Mp3</span>
      </div>
      <div class="strip-divider" aria-hidden="true"></div>
      <div class="strip-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3v5z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3v5z"/>
        </svg>
        <span><strong>{site.stats.mp3_tracks.replace('+', '')}</strong> temas ordenados por carpeta</span>
      </div>
      <div class="strip-divider" aria-hidden="true"></div>
      <div class="strip-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
        </svg>
        <span>Envíos a <strong>todo Chile</strong> en 24 horas</span>
      </div>
    </div>

  </div>
</section>

<style>
  .features {
    background: var(--light);
    padding: 100px 0 80px;
    position: relative;
  }

  .features-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .features-title {
    color: var(--text-dark);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* ─── Feature Card ───────────────────────────────── */
  .feature-card {
    background: var(--white);
    border: 1px solid rgba(115, 20, 189, 0.08);
    border-radius: var(--radius-lg);
    padding: 32px;
    display: flex;
    gap: 20px;
    align-items: flex-start;
    transition: transform 0.3s var(--ease-spring), box-shadow 0.3s ease, border-color 0.3s;
    cursor: default;
  }

  .feature-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 48px rgba(115, 20, 189, 0.12);
    border-color: rgba(115, 20, 189, 0.25);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, rgba(115, 20, 189, 0.12), rgba(213, 22, 122, 0.08));
    border: 1px solid rgba(115, 20, 189, 0.15);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--purple);
    transition: background 0.3s, transform 0.3s;
  }

  .feature-card:hover .feature-icon {
    background: linear-gradient(135deg, var(--purple), var(--pink));
    color: var(--white);
    border-color: transparent;
    transform: rotate(-4deg) scale(1.05);
  }

  .feature-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .feature-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--text-dark);
    line-height: 1.3;
  }

  .feature-desc {
    font-size: 14px;
    line-height: 1.7;
    color: #6B5A8A;
  }

  .feature-desc strong {
    color: var(--purple);
    font-weight: 600;
  }

  /* ─── Strip ──────────────────────────────────────── */
  .features-strip {
    margin-top: 48px;
    background: linear-gradient(135deg, var(--purple), var(--pink));
    border-radius: var(--radius-xl);
    padding: 28px 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
  }

  .strip-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.9);
  }

  .strip-item svg {
    color: rgba(255, 255, 255, 0.7);
    flex-shrink: 0;
  }

  .strip-item strong {
    color: var(--white);
    font-weight: 700;
  }

  .strip-divider {
    width: 1px;
    height: 32px;
    background: rgba(255, 255, 255, 0.25);
    flex-shrink: 0;
  }

  /* ─── Stagger reveal ─────────────────────────────── */
  .feature-card.reveal { transition-delay: calc(var(--i, 0) * 80ms); }
  .feature-card:nth-child(1) { --i: 0; }
  .feature-card:nth-child(2) { --i: 1; }
  .feature-card:nth-child(3) { --i: 2; }
  .feature-card:nth-child(4) { --i: 3; }
  .feature-card:nth-child(5) { --i: 4; }
  .feature-card:nth-child(6) { --i: 5; }

  /* ─── Responsive ─────────────────────────────────── */
  @media (max-width: 1100px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
    .feature-card {
      flex-direction: column;
      gap: 16px;
    }
    .features-strip {
      flex-direction: column;
      padding: 24px;
      gap: 20px;
      text-align: center;
    }
    .strip-divider {
      width: 40px;
      height: 1px;
    }
  }
</style>
