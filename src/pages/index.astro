---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import AboutSection from '../components/AboutSection.astro';
import Gallery from '../components/Gallery.astro';
import Pricing from '../components/Pricing.astro';
import Tutorials from '../components/Tutorials.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
---

<Layout
  title="KaraFun Chile — Cantar alegra la vida | Karaoke Profesional, Distribuidor Oficial"
  description={`Únicos autorizados KaraFun en Chile. Más de ${site.stats.active_clients} clientes en ${site.stats.years}+ años. ${site.stats.karaoke_tracks} temas de karaoke, videos musicales y música Mp3 en disco duro externo. Sin internet, solo necesitas un computador. Envíos a todo Chile en máx. ${site.shipping.delivery_max}.`}
>
  <Header />
  <main id="main-content">
    <Hero />
    <Features />
    <AboutSection />
    <Gallery />
    <Pricing />
    <Tutorials />
    <Contact />
  </main>
  <Footer />

  <!-- Global scroll reveal observer (covers all remaining .reveal elements) -->
  <script>
    (() => {
      const revealAll = document.querySelectorAll('.reveal:not(.is-visible)');
      if (!revealAll.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }
      );

      revealAll.forEach(el => observer.observe(el));
    })();
  </script>
</Layout>
